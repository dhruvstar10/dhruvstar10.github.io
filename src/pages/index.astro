---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';
import { externalArticles, writingSeries } from '../data/writing';
import { projects } from '../data/projects';
import { visiblePosts } from '../lib/posts';
const posts = (await visiblePosts()).slice(0, 3);
---
<Base>
  <section class="hero">
    <h1>Hi, I’m Dhruv.</h1>
    <p class="intro">I’m a product leader interested in AI, product strategy, and building tools that empower people.</p>
    <p class="hero-note">This is where I share my writing and what I’m learning along the way.</p>
  </section>
  <section class="writing-section" aria-labelledby="writing-heading">
    <p class="eyebrow" id="writing-heading">FEATURED SERIES</p>
    <div class="feature">
      <img class="feature-image" src={writingSeries.image} alt={writingSeries.imageAlt} width="1024" height="1024" fetchpriority="high" />
      <div class="feature-copy">
        <p class="eyebrow">THREE PARTS · ON SUBSTACK</p>
        <h2>{writingSeries.title}</h2>
        <p>{writingSeries.description}</p>
        <div class="part-links" aria-label="Read the series on Substack">{externalArticles.map((article, index) => <a href={article.url}>Part {index + 1}</a>)}</div>
      </div>
    </div>
    {posts.map(post => <article class="post-row"><p class="eyebrow">{post.data.draft ? 'LOCAL DRAFT' : post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</p><h2><a href={path(`blog/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}
  </section>
  <section class="projects-section" aria-labelledby="projects-heading">
    <p class="eyebrow" id="projects-heading">WHAT I’M BUILDING</p>
    {projects.map(project => <article class="project-summary"><div><h2><a href={path('projects/')}>{project.name}</a></h2><p>{project.description}</p></div><span class="project-status">{project.status}</span></article>)}
  </section>
</Base>
