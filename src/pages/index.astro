---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { path } from '../lib/paths';
import { visiblePosts } from '../lib/posts';
const posts = (await visiblePosts()).slice(0, 3);
---
<Base>
  <section class="hero">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span> THE PERSONAL SITE OF DHRUV GOEL</p>
    <h1>Hi, I’m Dhruv.<br /><em>Let’s build what’s next.</em></h1>
    <p class="intro">I’m a product leader passionate about AI, product strategy, and building tools that empower everyone.</p>
    <a class="text-link" href={path('blog/')}>Explore the writing <span aria-hidden="true">↗</span></a>
    <span class="hero-index" aria-hidden="true">DG / 01</span>
  </section>
  <section class="writing-section" aria-labelledby="writing-heading">
    <div class="section-label"><h2 id="writing-heading">THE WRITING</h2><span>Thoughts, in longer form.</span></div>
    <a class="feature" href={site.substack}>
      <div class="feature-art" aria-hidden="true"><span class="art-caption">NOTES & PERSPECTIVES</span><div class="rings"><i></i><i></i><i></i></div><span class="art-initial">dg.</span></div>
      <div class="feature-copy"><p class="eyebrow">ON SUBSTACK</p><h3>A starting point.<br />A space to keep writing.</h3><p>My first piece is on Substack. Start there, and follow along for what comes next.</p><span class="text-link">Read on Substack <span aria-hidden="true">↗</span></span></div>
    </a>
    {posts.map(post => <a class="post-row" href={path(`blog/${post.id}/`)}><div><p class="eyebrow">{post.data.draft ? 'LOCAL DRAFT' : post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</p><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span aria-hidden="true">↗</span></a>)}
  </section>
  <section class="subscribe"><div><p class="eyebrow">STAY IN THE LOOP</p><h2>More to come.</h2><p>Follow my writing on Substack.</p></div><a class="button" href={site.substack}>Find me on Substack <span aria-hidden="true">↗</span></a></section>
</Base>
