---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
---
<Base title="Projects" description="Things Dhruv Goel is building, including Auzar, an experimental AI companion for smart glasses.">
  <section class="page-heading"><h1>Projects.</h1><p class="intro">Ideas I’m exploring by building.</p></section>
  {projects.map(project => (
    <article class="project-detail">
      <p class="eyebrow">{project.status}</p>
      <h2>{project.name}</h2>
      <p class="project-tagline">{project.tagline}</p>
      <p>{project.description}</p>
      <div class="project-technologies" aria-label="Built with">{project.technologies.map(technology => <span>{technology}</span>)}</div>
      <h3>What works today</h3>
      <ul>{project.capabilities.map(capability => <li>{capability}</li>)}</ul>
      <h3>What’s next</h3>
      <p>{project.next}</p>
      <a class="text-link" href={project.repository}>View {project.name} on GitHub</a>
    </article>
  ))}
</Base>
