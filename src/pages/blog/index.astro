---
import ArticleList from '../../components/ArticleList.astro';
import { externalArticles, writingSeries } from '../../data/writing';
import Base from '../../layouts/Base.astro';
import { path } from '../../lib/paths';
import { visiblePosts } from '../../lib/posts';
const posts = await visiblePosts();
---
<Base title="Writing" description="Essays from Dhruv Goel on AI, product, and learning by doing.">
  <section class="page-heading"><h1>Writing.</h1><p class="intro">Experiments, observations, and lessons along the way.</p></section>
  <section aria-labelledby="series-title">
    <div class="series-intro"><p class="eyebrow">A THREE-PART SERIES ON SUBSTACK</p><h2 id="series-title">{writingSeries.title}</h2><p>{writingSeries.description}</p></div>
    <ArticleList articles={externalArticles} />
  </section>
  {posts.map(post => <article class="post-row"><p class="eyebrow">{post.data.draft ? 'LOCAL DRAFT' : post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p><h2><a href={path(`blog/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}
</Base>
