---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { path } from '../../lib/paths';
import { visiblePosts } from '../../lib/posts';
const posts = await visiblePosts();
---
<Base title="Writing" description="Writing and notes from Dhruv Goel. Read the first piece on Substack.">
  <section class="page-heading"><p class="eyebrow">THE WRITING</p><h1>Room to think.</h1><p class="intro">Ideas, observations, and things worth putting into words.</p></section>
  <section class="reading-panel"><p class="eyebrow">START ON SUBSTACK</p><h2>Where the writing began.</h2><p>My first piece lives on Substack. You can read it there and follow along for future posts.</p><a class="text-link" href={site.substack}>Visit my Substack <span aria-hidden="true">↗</span></a></section>
  {posts.map(post => <a class="post-row" href={path(`blog/${post.id}/`)}><div><p class="eyebrow">{post.data.draft ? 'LOCAL DRAFT' : post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p><h2>{post.data.title}</h2><p>{post.data.description}</p></div><span aria-hidden="true">↗</span></a>)}
</Base>
