---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { visiblePosts } from '../../lib/posts';
import { path } from '../../lib/paths';
export async function getStaticPaths() {
  return (await visiblePosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} noindex={post.data.draft}>
  <article class="article">
    <a class="text-link" href={path('blog/')}>← All writing</a>
    <header class="page-heading"><p class="eyebrow">{post.data.draft ? 'LOCAL DRAFT · NOT PUBLISHED' : post.data.date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}</p><h1>{post.data.title}</h1><p class="intro">{post.data.description}</p></header>
    <div class="prose"><Content /></div>
  </article>
</Base>
