---
import type { ExternalArticle } from '../data/writing';
interface Props { articles: ExternalArticle[] }
const { articles } = Astro.props;
---
<div class="article-list">
  {articles.map((article, index) => (
    <article class="article-entry">
      <p class="eyebrow">PART {index + 1}{article.date && <> · <time datetime={article.date}>{new Date(`${article.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></>}</p>
      <h3><a href={article.url}>{article.title}</a></h3>
      {article.description && <p>{article.description}</p>}
    </article>
  ))}
</div>
